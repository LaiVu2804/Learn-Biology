# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO DỰ ÁN LEARN BIOLOGY (.env.example)
# Hướng dẫn: Copy file này thành '.env' và điền các giá trị thực tế của bạn:
#   cp .env.example .env  (hoặc Copy-Item .env.example .env trên PowerShell)
# Lưu ý: File '.env' thực tế đã được chặn trong .gitignore để bảo mật thông tin.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CỔNG MẠNG DỊCH VỤ (HOST PORTS)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Bảo mật IP Binding cho Database & Redis:
# Mặc định bind vào 127.0.0.1 (chỉ máy host mới kết nối được, chống quét port từ Internet)
MYSQL_BIND_IP=127.0.0.1
MYSQL_LOCAL_PORT=3307

REDIS_BIND_IP=127.0.0.1
REDIS_LOCAL_PORT=6379

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH CƠ SỞ DỮ LIỆU (MYSQL)
# ------------------------------------------------------------------------------
DB_NAME=biology
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password_here
DB_ROOT_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH CACHE (REDIS)
# ------------------------------------------------------------------------------
# Để trống nếu không cài mật khẩu Redis trên môi trường phát triển cục bộ
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. SPRING BOOT PROFILE
# ------------------------------------------------------------------------------
# 'dev' (tự động cập nhật bảng Hibernate ddl-auto=update, log debug)
# 'prod' (validate schema, tắt debug log)
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 5. BẢO MẬT JWT (HMAC-SHA512 REQUIREMENT >= 64 BYTES / 512 BITS IN BASE64)
# ------------------------------------------------------------------------------
# Lệnh tạo chuỗi ngẫu nhiên an toàn trên Linux/macOS/Git Bash:
#   openssl rand -base64 64
# Trên Windows PowerShell:
#   [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=your_base64_encoded_512bit_secret_key_here
JWT_ACCESS_TOKEN_VALIDITY=3600
JWT_REFRESH_TOKEN_VALIDITY=604800

# ------------------------------------------------------------------------------
# 6. OAUTH2 GOOGLE (Tùy chọn)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (SMTP Gmail - Tùy chọn)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
